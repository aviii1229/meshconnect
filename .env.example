# MeshRoute Backend & Google Maps Configuration

PORT=3000

# ==============================================================================
# Google Maps JavaScript API Configuration
# ==============================================================================
# 1. Obtain an API Key from Google Cloud Console:
#    https://console.cloud.google.com/google/maps-apis/overview
# 2. Enable the required APIs for your project:
#    - Maps JavaScript API (REQUIRED)
# 3. Restrict your API key in production:
#    - Application restriction: HTTP referrers (web sites), e.g. https://yourdomain.com/*
#    - API restriction: Restrict key to "Maps JavaScript API"
# 4. Paste the key below:
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Optional: Custom Google Maps Vector Map ID (if using Advanced Markers or Cloud Styling)
# GOOGLE_MAPS_MAP_ID=YOUR_MAP_ID_HERE

# Default Map Preset:
# Options: terrain (Grand Canyon / Topo contour relief)
#          tactical (Dark navigation mode)
#          roadmap  (Standard Google street map)
#          hybrid   (Satellite imagery + roads)
MAP_STYLE_URL=terrain
